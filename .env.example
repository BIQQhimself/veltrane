# Copy to .env and fill in. Never commit the real file.
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"

VELTRANE_ENV=development
VELTRANE_SECRET_KEY=replace-me-with-48-random-characters-0000000000
VELTRANE_MASTER_ENCRYPTION_KEY=
VELTRANE_KEK_VERSION=1

# Used by docker-compose.yml to provision the local Postgres container.
POSTGRES_PASSWORD=choose-a-local-development-password
VELTRANE_DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@127.0.0.1:5432/veltrane
VELTRANE_REDIS_URL=redis://127.0.0.1:6379/0

VELTRANE_API_BASE_URL=http://localhost:8000
VELTRANE_WEB_BASE_URL=http://localhost:3000
VELTRANE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VELTRANE_LOG_LEVEL=INFO

VELTRANE_ACCESS_TOKEN_MINUTES=15
VELTRANE_REFRESH_TOKEN_DAYS=14
VELTRANE_REQUIRE_EMAIL_VERIFICATION=true
VELTRANE_COOKIE_SECURE=false
VELTRANE_MFA_ISSUER=VELTRANE

# Keep live trading off. It is a platform-wide gate in addition to per-user authorisation.
VELTRANE_LIVE_TRADING_ENABLED=false
VELTRANE_DEMO_MARKET_DATA_ENABLED=true
VELTRANE_MARKET_DATA_SOURCE=demo
VELTRANE_MARKET_DATA_CACHE_SECONDS=20

# ---- Deriv broker (token-only auth; there is no API secret) ------------------------------
# Register an application at developers.deriv.com to obtain an app id. Tokens must be issued
# with read and trade scopes only — never withdrawal.
VELTRANE_DERIV_APP_ID=
VELTRANE_DERIV_REST_BASE=https://api.derivws.com
VELTRANE_DERIV_PUBLIC_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# Optional OAuth 2.0 (leave blank to accept Personal Access Tokens only).
VELTRANE_DERIV_OAUTH_CLIENT_ID=
VELTRANE_DERIV_OAUTH_REDIRECT_URI=
VELTRANE_DERIV_SESSION_MAX_FAILURES=5
VELTRANE_DERIV_AUTOTRADE_RUNNER_ENABLED=true
VELTRANE_DERIV_AUTOTRADE_INTERVAL_SECONDS=120

VELTRANE_PAPER_TAKER_FEE_BPS=10.0
VELTRANE_PAPER_SPREAD_BPS=4.0
VELTRANE_PAPER_SLIPPAGE_BPS=3.0
VELTRANE_PAPER_STARTING_BALANCE=25000

# mock is refused in production
VELTRANE_BILLING_PROVIDER=mock
VELTRANE_STRIPE_SECRET_KEY=
VELTRANE_STRIPE_WEBHOOK_SECRET=
VELTRANE_BILLING_WEBHOOK_TOLERANCE_SECONDS=300

VELTRANE_ADMIN_EMAIL=admin@veltrane.dev
VELTRANE_ADMIN_PASSWORD=
