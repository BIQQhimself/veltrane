# ---------- Core ----------
VELTRANE_ENV=development            # development | test | production
VELTRANE_APP_NAME=VELTRANE
VELTRANE_API_BASE_URL=http://localhost:8000
VELTRANE_WEB_BASE_URL=http://localhost:3000
VELTRANE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Secrets (generate your own; never commit real values) ----------
# openssl rand -hex 32
VELTRANE_SECRET_KEY=change-me-development-only-0000000000000000000000000000
# openssl rand -base64 32  (AES-256 master key for envelope encryption of provider credentials)
VELTRANE_MASTER_ENCRYPTION_KEY=
VELTRANE_KEK_VERSION=1

# ---------- Data stores ----------
# Used by docker-compose.yml to provision the local Postgres container.
POSTGRES_PASSWORD=choose-a-local-development-password
VELTRANE_DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@127.0.0.1:5432/veltrane
VELTRANE_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Auth ----------
VELTRANE_ACCESS_TOKEN_MINUTES=15
VELTRANE_REFRESH_TOKEN_DAYS=14
VELTRANE_REQUIRE_EMAIL_VERIFICATION=true
VELTRANE_COOKIE_SECURE=false
VELTRANE_MFA_ISSUER=VELTRANE

# ---------- Safety ----------
# Process-wide master switch. Live order submission is impossible while false.
VELTRANE_LIVE_TRADING_ENABLED=false
# Allows the clearly-labelled synthetic feed when public market data is unreachable.
VELTRANE_DEMO_MARKET_DATA_ENABLED=true
# Paper engine: taker fee in basis points, spread in bps, base slippage in bps
VELTRANE_PAPER_TAKER_FEE_BPS=10
VELTRANE_PAPER_SPREAD_BPS=4
VELTRANE_PAPER_SLIPPAGE_BPS=3
VELTRANE_PAPER_STARTING_BALANCE=25000

# ---------- Billing ----------
VELTRANE_BILLING_PROVIDER=mock          # mock | stripe
VELTRANE_STRIPE_SECRET_KEY=
VELTRANE_STRIPE_WEBHOOK_SECRET=
VELTRANE_BILLING_WEBHOOK_TOLERANCE_SECONDS=300

# ---------- Market data ----------
VELTRANE_MARKET_DATA_SOURCE=ccxt        # ccxt | demo
VELTRANE_MARKET_DATA_CACHE_SECONDS=20

# ---------- Ops ----------
VELTRANE_LOG_LEVEL=INFO
VELTRANE_ADMIN_EMAIL=admin@veltrane.local
VELTRANE_ADMIN_PASSWORD=            # only used by the seed script; leave empty to skip
